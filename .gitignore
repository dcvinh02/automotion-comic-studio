# Workspace user data (keep folder structure via .gitkeep)
workspace/asset_library/library.db*
workspace/asset_library/characters/*
!workspace/asset_library/characters/.gitkeep
workspace/asset_library/locations/*
!workspace/asset_library/locations/.gitkeep
workspace/asset_library/props/*
!workspace/asset_library/props/.gitkeep
workspace/asset_library/poses/*
!workspace/asset_library/poses/.gitkeep
workspace/asset_library/expressions/*
!workspace/asset_library/expressions/.gitkeep
workspace/asset_library/animations/*
!workspace/asset_library/animations/.gitkeep
workspace/asset_library/sounds/*/*
!workspace/asset_library/sounds/*/.gitkeep
workspace/projects/*
!workspace/projects/.gitkeep

# Logs & temp
logs/
tmp/
*.tmp
